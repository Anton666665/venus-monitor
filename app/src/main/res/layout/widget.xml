<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#E6202428">
    <TextView android:id="@+id/w_main" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_grid" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFD54F" android:textSize="14sp" />
    <TextView android:id="@+id/w_avg" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#DDDDDD" android:textSize="14sp" />
    <TextView android:id="@+id/w_real" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#DDDDDD" android:textSize="14sp" />
</LinearLayout>
